# MonMag environment template.
# Copy to .env.local and replace placeholders with your own values.
# NEVER commit .env.local or real credentials. All values below are placeholders.

# ---------------------------------------------------------------------------
# Clerk (only authentication provider)
# See docs/SETUP.md for development setup and docs/DEPLOYMENT.md for production.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Optional. Reserved for webhook signature verification; no webhook route ships
# in this repository yet. Set only when you add a verified webhook endpoint.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me

# ---------------------------------------------------------------------------
# PostgreSQL (Supabase-compatible)
# DATABASE_URL is required by the app, Prisma CLI, and prisma.config.ts.
# Supabase options:
#   - transaction pooler: regional pooler host, port 6543, user postgres.<ref>,
#     with ?pgbouncer=true&connection_limit=1
#   - session pooler: regional pooler host, port 5432, user postgres.<ref>,
#     IPv4-compatible; omit pgbouncer=true
# Direct db.<ref>.supabase.co:5432 may be IPv6-only on some projects.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&connection_limit=1

# Optional direct connection (db.<ref>.supabase.co:5432). Documented for
# migration workflows; prisma.config.ts currently reads only DATABASE_URL.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ---------------------------------------------------------------------------
# Application URLs
# Absolute origin used for redirects and links.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Demo seed (development/test databases only)
# DEMO_CLERK_USER_ID must be a Clerk test user id; never a real account.
# DEMO_SEED=false is an explicit kill switch; omit or leave empty to enable.
# Do not set these in production.
# ---------------------------------------------------------------------------
DEMO_CLERK_USER_ID=
DEMO_SEED=
